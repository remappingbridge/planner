  "notes": [
    "Template rows are raw C source strings, not complete projected frames; firmware overwrites dynamic rows and overlays color and pipe markers at runtime.",
    "The firmware's frame_set_text writes at most 21 columns. The raw source has rows longer than 21; web renderer must clip visually without editing source strings.",
    "hintStartRow is computed using firmware first_hint_row plus four explicit layout exceptions; this is metadata, not a live framebuffer snapshot.",
    "focus.rows uses actual MNT-13 final pipe rows, and SAVED DEVICES is conditional on having a valid bond."
  ],
  "geometry": {
    "width": 240,
    "height": 240,
    "rows": 9,
    "columns": 21
  },
